# Copy to .env.surfshark (never commit real values; chmod 600).
# Managed upload UI (compose.wireguard.yaml) needs ONLY
# SURFSHARK_CONTROL_API_KEY; upload WireGuard private keys in the web UI.
# The static credentials below are for the *older* Gluetun override
# (compose.surfshark.yaml) and are ignored in managed UI mode.
# Surfshark -> VPN -> Manual setup -> WireGuard -> generate keypair.
SURFSHARK_WIREGUARD_PRIVATE_KEY=PASTE_YOUR_PRIVATE_KEY_HERE
# IPv4 Address field from the downloaded Surfshark WireGuard config (CIDR).
SURFSHARK_WIREGUARD_ADDRESSES=10.0.0.2/16
# A comma-separated Gluetun-supported set is also possible.
SURFSHARK_SERVER_COUNTRIES=Netherlands
# Random secret; for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SURFSHARK_CONTROL_API_KEY=GENERATE_YOUR_OWN_LONG_RANDOM_SECRET
# Off by default. When enabled, after a second HTTP 403 a bounded VPN
# reconnect will be attempted once, before the last yt-dlp retry.
SURFSHARK_ROTATE_ON_403=0
